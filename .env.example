# Copy to .env for local dev, or paste each value into your host's dashboard.
# Never commit a filled-in .env.

# Port the API listens on. Render sets this automatically - leave it unset there.
PORT=5000

# MongoDB Atlas connection string (mongodb+srv://...). Local MongoDB will not
# work once deployed.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.XXXXXX.mongodb.net/shoply

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encrypts seller bank details at rest (AES-256-GCM). Set this to a DIFFERENT
# value from JWT_SECRET so payout encryption can be rotated independently of
# session tokens. If unset, JWT_SECRET is used as a fallback.
# Rotating it makes existing stored bank details unreadable.
PAYOUT_ENCRYPTION_KEY=

# Comma-separated list of frontend origins allowed by CORS, e.g.
#   https://shoply.vercel.app,https://shoply-git-main-you.vercel.app
# Local dev: http://localhost:5173
CLIENT_URL=http://localhost:5173

# SMTP for password-reset emails. Use a real provider in production;
# leaving these blank makes the API return the OTP to the caller.
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
